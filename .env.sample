# ==============================================================================
# Environment Configuration Sample (.env.sample)
# Project: DSA with C Platform Backend
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env` in the `backend/` directory:
#      cp .env.sample .env
# 2. Update the placeholder values below with your local or production settings.
# 3. DO NOT commit your actual `.env` file containing sensitive credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
# Port number on which the Express server will listen
PORT=8000

# Application environment ('development' | 'production')
# In 'development', detailed error stack traces are included in API error responses
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection string (without the trailing database name, 
# as DB_NAME 'dsa_platform' is appended automatically in src/db/index.js)
#
# Examples:
# - MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
# - Local MongoDB:         mongodb://127.0.0.1:27017
MONGODB_URI="mongodb://127.0.0.1:27017"

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------
# Allowed origin(s) for frontend clients connecting to this backend
# Examples:
# - Local Frontend (Vite config port 3000): http://localhost:3000
# - Standard Vite fallback port:           http://localhost:5173
# - Development (Allow all):               *
# - Production:                            https://dsa-with-c.vercel.app
CORS_ORIGIN=http://localhost:3000
